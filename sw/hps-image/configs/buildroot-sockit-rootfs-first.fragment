# Initial Buildroot direction for the SoCKit "Option A" path.
#
# This is not yet a final defconfig. It is a checked-in fragment capturing the
# intended first-pass feature set so future work does not have to rediscover it.

BR2_arm=y
BR2_cortex_a9=y
BR2_ARM_ENABLE_NEON=y
BR2_ARM_ENABLE_VFP=y
BR2_ARM_FPU_NEON=y

# First pass: prioritize a useful userspace and rootfs over replacing every boot
# component immediately.
BR2_TARGET_GENERIC_GETTY=y
BR2_TARGET_GENERIC_GETTY_PORT="ttyS0"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_115200=y
BR2_TARGET_ENABLE_ROOT_LOGIN=y

BR2_SYSTEM_DHCP="eth0"
BR2_ROOTFS_POST_FAKEROOT_SCRIPT=""
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="256M"
BR2_TARGET_TAR=y

BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_BINUTILS=y
BR2_PACKAGE_GDB=y
BR2_PACKAGE_OPENSSH=y
BR2_PACKAGE_OPENSSH_SERVER=y
BR2_PACKAGE_DROPBEAR=n
BR2_PACKAGE_NANO=y
BR2_PACKAGE_LESS=y
BR2_PACKAGE_STRACE=y
BR2_PACKAGE_RSYNC=y

# Build host helpers for image assembly once the board-specific flow is nailed
# down.
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_MTOOLS=y
