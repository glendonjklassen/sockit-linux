BR2_arm=y
BR2_cortex_a9=y
BR2_ARM_ENABLE_NEON=y
BR2_ARM_ENABLE_VFP=y
BR2_ARM_FPU_NEON=y
BR2_TOOLCHAIN_BUILDROOT_MUSL=y
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_5_11=y
BR2_TARGET_GENERIC_HOSTNAME="sockit"
BR2_TARGET_GENERIC_GETTY=y
BR2_TARGET_GENERIC_GETTY_PORT="ttyS0"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_115200=y
BR2_SYSTEM_DHCP="eth0"
BR2_TARGET_ENABLE_ROOT_LOGIN=y
# Root password locked in post-build.sh by overwriting /etc/shadow.
# Setting BR2_TARGET_GENERIC_ROOT_PASSWD here doesn't help — that variable
# is plaintext, so "!" would just hash the literal "!" as the password.
BR2_ROOTFS_POST_BUILD_SCRIPT="$(CONFIG_DIR)/board/sockit_cyclone5/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(CONFIG_DIR)/board/sockit_cyclone5/post-image.sh"
BR2_ROOTFS_POST_SCRIPT_ARGS="-c $(CONFIG_DIR)/board/sockit_cyclone5/genimage-barebox.cfg"
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_GIT=y
BR2_LINUX_KERNEL_CUSTOM_REPO_URL="https://github.com/altera-opensource/linux-socfpga.git"
BR2_LINUX_KERNEL_CUSTOM_REPO_VERSION="rel_socfpga-5.11_21.06.01_pr"
BR2_LINUX_KERNEL_DEFCONFIG="socfpga"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(CONFIG_DIR)/board/sockit_cyclone5/kernel.fragment"
BR2_LINUX_KERNEL_PATCH="$(CONFIG_DIR)/board/sockit_cyclone5/linux-patches"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_CUSTOM_DTS_PATH="$(CONFIG_DIR)/board/sockit_cyclone5/dts/socfpga_cyclone5_sockit.dts"
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(CONFIG_DIR)/board/sockit_cyclone5/busybox.fragment"
BR2_PACKAGE_STRACE=y
BR2_PACKAGE_BINUTILS=y
BR2_PACKAGE_BINUTILS_TARGET=y
BR2_PACKAGE_OPENSSH=y
BR2_PACKAGE_OPENSSH_SERVER=y
# Entropy daemon. Kernel 5.11 on the Cyclone V has no hardware RNG, so on first boot
# ssh-keygen (S50sshd) can block indefinitely on getrandom() waiting for the pool to
# initialize, and sshd never starts. haveged (S21) fills the pool within seconds.
BR2_PACKAGE_HAVEGED=y
BR2_PACKAGE_RSYNC=y
BR2_PACKAGE_LESS=y
BR2_PACKAGE_NANO=y
BR2_PACKAGE_IPROUTE2=y
BR2_PACKAGE_ETHTOOL=y
BR2_PACKAGE_IPTABLES=y
BR2_TARGET_BAREBOX=y
BR2_TARGET_BAREBOX_CUSTOM_VERSION=y
BR2_TARGET_BAREBOX_CUSTOM_VERSION_VALUE="2021.07.0"
BR2_TARGET_BAREBOX_BOARD_DEFCONFIG="socfpga"
BR2_TARGET_BAREBOX_IMAGE_FILE="images/barebox-socfpga-sockit.img"
BR2_TARGET_BAREBOX_CUSTOM_ENV=y
BR2_TARGET_BAREBOX_CUSTOM_ENV_PATH="$(CONFIG_DIR)/board/sockit_cyclone5/barebox-env"
BR2_TARGET_BAREBOX_AUX=y
BR2_TARGET_BAREBOX_AUX_BOARD_DEFCONFIG="socfpga-xload"
BR2_TARGET_BAREBOX_AUX_IMAGE_FILE="images/barebox-socfpga-sockit-xload.img"
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_MTOOLS=y
BR2_PACKAGE_HOST_ENVIRONMENT_SETUP=y
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="512M"
# ^orphan_file: e2fsprogs 1.47 enables it by default; a newer host kernel that mounts the card
# sets orphan_present (RO_COMPAT), and if the card is pulled before a clean unmount the
# board's 5.11 kernel (no orphan_file support) mounts root read-only: no sshd host keys.
BR2_TARGET_ROOTFS_EXT2_MKFS_OPTIONS="-O ^metadata_csum,^64bit,^orphan_file"
BR2_TARGET_ROOTFS_TAR=y
